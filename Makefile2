# --- Переменные ---
TARGET = main_content.docx
SOURCE = section1.md section2.md
REFERENCE = reference.docx
FILTERS = --lua-filter=pagebreak.lua --filter pandoc-crossref

# Укажите полный путь к pandoc, если он не находится автоматически
# PANDOC = "C:/Program Files/Pandoc/pandoc.exe"
PANDOC ?= pandoc

# Опции Pandoc
PANDOC_OPTS = --standalone --number-sections $(FILTERS) --reference-doc=$(REFERENCE) 
# PANDOC_OPTS =  $(FILTERS) --reference-doc=$(REFERENCE)


# --- Цели (Targets) ---
all: $(TARGET)

# Правило для сборки DOCX (используем переменную $(PANDOC))
$(TARGET): $(SOURCE) $(REFERENCE) pagebreak.lua
	$(PANDOC) $(SOURCE) -o $(TARGET) $(PANDOC_OPTS)

# Очистка сгенерированных файлов
clean:
	rm -f $(TARGET)

.PHONY: all clean